# 실제 키와 비밀번호를 입력하지 않는 공유용 예시입니다.
FINLIFE_API_KEY=
YOUTH_POLICY_API_KEY=
CENTRAL_WELFARE_SERVICE_KEY=
FSS_OPEN_API_KEY=

# backend/ (FastAPI) 전용. 스크립트·CLI에는 쓰이지 않는다.
CORS_ORIGINS=http://localhost:3000
ENABLE_VECTOR_RAG=false

# Gemini API: LLM 설명 생성 및 RAG 임베딩
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=1536
ENABLE_GEMINI=true
ENABLE_GEMINI_PLANNER=true
ENABLE_GEMINI_WEB_SEARCH=true
GEMINI_WEB_SEARCH_MONTHLY_LIMIT=1000

POSTGRES_DB=roadmap_agent
POSTGRES_USER=roadmap_agent
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
