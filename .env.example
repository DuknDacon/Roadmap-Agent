# 실제 키와 비밀번호를 입력하지 않는 공유용 예시입니다.
FINLIFE_API_KEY=
YOUTH_POLICY_API_KEY=
CENTRAL_WELFARE_SERVICE_KEY=
FSS_OPEN_API_KEY=

# backend/ (FastAPI) 전용. 스크립트·CLI에는 쓰이지 않는다.
CORS_ORIGINS=http://localhost:3000
ENABLE_RAG=true
RAG_INDEX_DIR=./data/rag_index
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6

# Gemini API: LLM 설명과 RAG 임베딩
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=1536
ENABLE_GEMINI=true
ENABLE_GEMINI_PLANNER=true
ENABLE_GEMINI_WEB_SEARCH=true
GEMINI_WEB_SEARCH_MONTHLY_LIMIT=1000

# 정형 데이터와 기능 2 대화 체크포인트를 함께 저장하는 공용 SQLite.
# Docker에서는 compose가 /app/data/shared/seedup.sqlite 로 고정한다.
SHARED_DB_PATH=./data/shared/seedup.sqlite
