CORS_ORIGINS=http://localhost:3000
ENABLE_VECTOR_RAG=false

# Gemini API: LLM 설명 생성 및 RAG 임베딩
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=1536
ENABLE_GEMINI=true
ENABLE_GEMINI_PLANNER=true
ENABLE_GEMINI_WEB_SEARCH=true
GEMINI_WEB_SEARCH_MONTHLY_LIMIT=1000

POSTGRES_DB=roadmap_agent
POSTGRES_USER=roadmap_agent
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
